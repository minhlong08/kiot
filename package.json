{
  "name": "phuongdong-pos",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @pd/api db:setup && pnpm -r --parallel --filter \"./apps/*\" dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test",
    "build": "pnpm --filter ./apps/admin --filter ./apps/pos build",
    "start": "pnpm build && pnpm --filter @pd/api db:setup && pnpm --filter @pd/api start"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
