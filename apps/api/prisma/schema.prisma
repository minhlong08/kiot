generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Branch {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  phone     String   @default("")
  address   String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  users     UserBranch[]
}

model Role {
  id                 Int              @id @default(autoincrement())
  name               String           @unique
  isAdmin            Boolean          @default(false)
  maxDiscountPercent Int              @default(100)
  permissions        RolePermission[]
  users              User[]
}

model RolePermission {
  roleId Int
  key    String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, key])
}

model User {
  id                 Int          @id @default(autoincrement())
  username           String       @unique
  phone              String?      @unique
  email              String?      @unique
  fullName           String
  passwordHash       String
  mustChangePassword Boolean      @default(false)
  isActive           Boolean      @default(true)
  roleId             Int
  role               Role         @relation(fields: [roleId], references: [id])
  defaultBranchId    Int?
  branchAccess       UserBranch[]
  sessions           Session[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model UserBranch {
  userId   Int
  branchId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Session {
  id         String   @id
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   Int
  ip         String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model Setting {
  key   String @id
  value String
}

model DocumentSequence {
  prefix String @id
  next   Int    @default(1)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  branchId   Int?
  action     String
  entity     String
  entityId   String
  entityCode String   @default("")
  summary    String
  searchText String   @default("")
  diff       String   @default("{}")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────── Catalogue & stock (M2) ─────────────

model ProductGroup {
  id       Int    @id @default(autoincrement())
  name     String
  parentId Int?
  sort     Int    @default(0)

  @@index([parentId])
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Location {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Product {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  barcode           String?
  name              String
  searchText        String   @default("")
  type              String   @default("goods")
  groupId           Int?
  brandId           Int?
  locationId        Int?
  parentId          Int?
  variantLabel      String   @default("")
  attributes        String   @default("[]")
  unit              String   @default("")
  price             Int      @default(0)
  cost              Int      @default(0)
  minStock          Int      @default(0)
  maxStock          Int      @default(999999999)
  weight            Int      @default(0)
  description       String   @default("")
  note              String   @default("")
  orderNoteTemplate String   @default("")
  vatRate           Int?
  loyaltyEnabled    Boolean  @default(true)
  points            Int?
  isDirectSale      Boolean  @default(true)
  sellOnline        Boolean  @default(false)
  isActive          Boolean  @default(true)
  allBranches       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([searchText])
  @@index([groupId])
  @@index([parentId])
  @@index([barcode])
}

model ProductBranch {
  productId Int
  branchId  Int

  @@id([productId, branchId])
}

model ProductUnit {
  id           Int     @id @default(autoincrement())
  productId    Int
  name         String
  conversion   Int
  code         String  @unique
  barcode      String?
  price        Int
  isDirectSale Boolean @default(true)

  @@index([productId])
  @@index([barcode])
}

model ComboItem {
  comboId Int
  itemId  Int
  qty     Int

  @@id([comboId, itemId])
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  sort      Int    @default(0)

  @@index([productId])
}

model ProductWarranty {
  id           Int    @id @default(autoincrement())
  productId    Int
  kind         String
  name         String
  duration     Int
  durationUnit String

  @@index([productId])
}

model BranchStock {
  productId Int
  branchId  Int
  onHand    Int @default(0)
  cost      Int @default(0)
  reserved  Int @default(0)
  incoming  Int @default(0)

  @@id([productId, branchId])
}

model StockLedger {
  id           Int      @id @default(autoincrement())
  productId    Int
  branchId     Int
  docType      String
  docId        Int
  docCode      String
  qtyChange    Int
  unitCost     Int
  balanceAfter Int
  costAfter    Int
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([productId, branchId, id])
  @@index([docType, docId])
  @@index([createdAt])
}

model PriceBook {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  isActive          Boolean   @default(true)
  startAt           DateTime?
  endAt             DateTime?
  branchIds         String    @default("[]")
  customerGroupIds  String    @default("[]")
  userIds           String    @default("[]")
  allowOutsideItems Boolean   @default(true)
  createdAt         DateTime  @default(now())
}

model PriceBookItem {
  priceBookId Int
  productId   Int
  price       Int

  @@id([priceBookId, productId])
}

model StockTake {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  branchId       Int
  status         String    @default("draft")
  note           String    @default("")
  createdById    Int
  balancedAt     DateTime?
  createdAt      DateTime  @default(now())
  totalActualQty Int       @default(0)
  totalDiffQty   Int       @default(0)
  totalDiffValue Int       @default(0)
  lines          StockTakeLine[]
}

model StockTakeLine {
  id          Int       @id @default(autoincrement())
  stockTakeId Int
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   Int
  systemQty   Int       @default(0)
  actualQty   Int
  diffQty     Int       @default(0)
  cost        Int       @default(0)
  diffValue   Int       @default(0)

  @@index([stockTakeId])
}

model StockIssue {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  kind        String
  branchId    Int
  status      String    @default("draft")
  reason      String    @default("")
  note        String    @default("")
  createdById Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  totalQty    Int       @default(0)
  totalValue  Int       @default(0)
  lines       StockIssueLine[]
}

model StockIssueLine {
  id        Int        @id @default(autoincrement())
  issueId   Int
  issue     StockIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId Int
  qty       Int
  cost      Int        @default(0)
  value     Int        @default(0)

  @@index([issueId])
}

model Transfer {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  fromBranchId     Int
  toBranchId       Int
  status           String    @default("draft")
  note             String    @default("")
  createdById      Int
  sentAt           DateTime?
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())
  totalSentQty     Int       @default(0)
  totalReceivedQty Int       @default(0)
  totalValue       Int       @default(0)
  lines            TransferLine[]
}

model TransferLine {
  id          Int      @id @default(autoincrement())
  transferId  Int
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   Int
  qtySent     Int
  qtyReceived Int      @default(0)
  cost        Int      @default(0)

  @@index([transferId])
}

// ───────────── Suppliers, purchasing, cash core (M3) ─────────────

model SupplierGroup {
  id   Int    @id @default(autoincrement())
  name String @unique
  note String @default("")
}

model Supplier {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  searchText String   @default("")
  phone      String   @default("")
  email      String   @default("")
  taxCode    String   @default("")
  address    String   @default("")
  company    String   @default("")
  groupId    Int?
  note       String   @default("")
  isActive   Boolean  @default(true)
  debt       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([searchText])
}

model PartnerLedger {
  id           Int      @id @default(autoincrement())
  partnerType  String
  partnerId    Int
  docType      String
  docId        Int
  docCode      String
  amount       Int
  balanceAfter Int
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([partnerType, partnerId, id])
  @@index([docType, docId])
}

model CashFund {
  id             Int      @id @default(autoincrement())
  type           String
  name           String
  bankName       String   @default("")
  bankBin        String   @default("")
  accountNumber  String   @default("")
  accountName    String   @default("")
  branchId       Int?
  isActive       Boolean  @default(true)
  openingBalance Int      @default(0)
  createdAt      DateTime @default(now())
}

model CashCategory {
  id         Int     @id @default(autoincrement())
  kind       String
  name       String
  isSystem   Boolean @default(false)
  affectsPnl Boolean @default(true)

  @@unique([kind, name])
}

model CashVoucher {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  kind             String
  fundId           Int
  branchId         Int
  amount           Int
  categoryId       Int
  counterpartyType String
  counterpartyId   Int?
  counterpartyName String   @default("")
  sourceType       String?
  sourceId         Int?
  sourceCode       String?
  note             String   @default("")
  status           String   @default("completed")
  affectsPnl       Boolean  @default(true)
  createdById      Int
  createdAt        DateTime @default(now())

  @@index([fundId, createdAt])
  @@index([sourceType, sourceId])
  @@index([branchId, createdAt])
}

model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  supplierId  Int
  branchId    Int
  status      String    @default("draft")
  expectedAt  DateTime?
  note        String    @default("")
  subtotal    Int       @default(0)
  discount    Int       @default(0)
  total       Int       @default(0)
  createdById Int
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  closedManually Boolean @default(false)
  lines       PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  orderId     Int
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  unitId      Int?
  conversion  Int           @default(1)
  qty         Int
  unitCost    Int
  discount    Int           @default(0)
  receivedQty Int           @default(0)

  @@index([orderId])
}

model PurchaseReceipt {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  supplierId      Int
  branchId        Int
  purchaseOrderId Int?
  invoiceNo       String    @default("")
  status          String    @default("draft")
  subtotal        Int       @default(0)
  discount        Int       @default(0)
  otherCosts      Int       @default(0)
  total           Int       @default(0)
  paid            Int       @default(0)
  fundId          Int?
  note            String    @default("")
  createdById     Int
  createdAt       DateTime  @default(now())
  effectiveAt     DateTime?
  completedAt     DateTime?
  lines           PurchaseReceiptLine[]

  @@index([supplierId])
  @@index([branchId, createdAt])
}

model PurchaseReceiptLine {
  id          Int             @id @default(autoincrement())
  receiptId   Int
  receipt     PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId   Int
  unitId      Int?
  conversion  Int             @default(1)
  qty         Int
  unitCost    Int
  discount    Int             @default(0)
  amount      Int             @default(0)
  baseCost    Int             @default(0)
  returnedQty Int             @default(0)

  @@index([receiptId])
}

model PurchaseReturn {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  supplierId  Int
  branchId    Int
  receiptId   Int?
  status      String    @default("draft")
  subtotal    Int       @default(0)
  discount    Int       @default(0)
  total       Int       @default(0)
  refund      Int       @default(0)
  fundId      Int?
  note        String    @default("")
  createdById Int
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  lines       PurchaseReturnLine[]

  @@index([supplierId])
}

model PurchaseReturnLine {
  id         Int            @id @default(autoincrement())
  returnId   Int
  ret        PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId  Int
  unitId     Int?
  conversion Int            @default(1)
  qty        Int
  price      Int
  amount     Int            @default(0)
  cost       Int            @default(0)

  @@index([returnId])
}

model IncomingInvoice {
  id              Int      @id @default(autoincrement())
  invoiceNo       String
  series          String   @default("")
  issuedAt        DateTime
  supplierId      Int?
  supplierName    String   @default("")
  supplierTaxCode String   @default("")
  receiptId       Int?
  purchaseOrderId Int?
  subtotal        Int      @default(0)
  vatAmount       Int      @default(0)
  total           Int      @default(0)
  note            String   @default("")
  createdAt       DateTime @default(now())

  @@unique([series, invoiceNo, supplierTaxCode])
}

model ServicePurchase {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  supplierId  Int?
  branchId    Int
  serviceName String
  categoryId  Int
  amount      Int
  paid        Int      @default(0)
  fundId      Int?
  status      String   @default("completed")
  note        String   @default("")
  createdById Int
  createdAt   DateTime @default(now())
}

// ───────────── Customers, loyalty, promotions, messaging (M4) ─────────────

model CustomerGroup {
  id              Int    @id @default(autoincrement())
  name            String @unique
  discountPercent Int    @default(0)
  minTotalSpent   Int?
  note            String @default("")
}

model Customer {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  searchText     String    @default("")
  phone          String    @default("")
  phone2         String    @default("")
  email          String    @default("")
  birthday       DateTime?
  birthMonth     Int?
  gender         String    @default("")
  type           String    @default("person")
  company        String    @default("")
  taxCode        String    @default("")
  address        String    @default("")
  ward           String    @default("")
  province       String    @default("")
  groupId        Int?
  note           String    @default("")
  isActive       Boolean   @default(true)
  debt           Int       @default(0)
  points         Int       @default(0)
  totalSpent     Int       @default(0)
  lastPurchaseAt DateTime?
  createdById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phone])
  @@index([searchText])
  @@index([groupId])
}

model LoyaltyTransaction {
  id           Int      @id @default(autoincrement())
  customerId   Int
  docType      String
  docId        Int
  docCode      String
  points       Int
  balanceAfter Int
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([customerId, id])
  @@index([docType, docId])
}

model Promotion {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  name             String
  type             String
  isActive         Boolean   @default(true)
  startAt          DateTime?
  endAt            DateTime?
  daysOfWeek       String    @default("[]")
  hours            String    @default("[]")
  branchIds        String    @default("[]")
  customerGroupIds String    @default("[]")
  combinable       Boolean   @default(false)
  config           String    @default("{}")
  note             String    @default("")
  createdAt        DateTime  @default(now())
}

model VoucherCampaign {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  value       Int
  unit        String
  maxDiscount Int?
  minOrder    Int       @default(0)
  startAt     DateTime?
  endAt       DateTime?
  multiUse    Boolean   @default(false)
  combinable  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Voucher {
  id            Int       @id @default(autoincrement())
  campaignId    Int
  code          String    @unique
  status        String    @default("unused")
  usedAt        DateTime?
  usedInvoiceId Int?
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([campaignId])
}

model MessageTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  channel   String   @default("sms")
  body      String
  createdAt DateTime @default(now())
}

model MessageLog {
  id          Int      @id @default(autoincrement())
  customerId  Int?
  phone       String   @default("")
  channel     String
  body        String
  status      String
  provider    String   @default("")
  error       String   @default("")
  createdById Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Sales: invoices, returns, customer orders, shifts (M5) ─────────────

model Invoice {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  clientUuid     String?   @unique
  branchId       Int
  customerId     Int?
  sellerId       Int
  createdById    Int
  channel        String    @default("store")
  priceBookId    Int?
  status         String    @default("completed")
  subtotal       Int       @default(0)
  promoDiscount  Int       @default(0)
  invoiceDiscount Int      @default(0)
  voucherCode    String?
  voucherDiscount Int      @default(0)
  pointsUsed     Int       @default(0)
  pointsValue    Int       @default(0)
  otherIncome    Int       @default(0)
  roundingAdjust Int       @default(0)
  total          Int       @default(0)
  paid           Int       @default(0)
  change         Int       @default(0)
  debt           Int       @default(0)
  costTotal      Int       @default(0)
  pointsEarned   Int       @default(0)
  returnedTotal  Int       @default(0)
  promotions     String    @default("[]")
  isDelivery     Boolean   @default(false)
  note           String    @default("")
  orderId        Int?
  shiftId        Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?
  lines          InvoiceLine[]
  payments       InvoicePayment[]

  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     Int
  unitId        Int?
  conversion    Int     @default(1)
  qty           Int
  price         Int
  discount      Int     @default(0)
  promoDiscount Int     @default(0)
  amount        Int
  cost          Int     @default(0)
  returnedQty   Int     @default(0)
  note          String  @default("")
  isGift        Boolean @default(false)

  @@index([invoiceId])
  @@index([productId])
}

model InvoicePayment {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method        String
  amount        Int
  fundId        Int?
  cashVoucherId Int?

  @@index([invoiceId])
}

model InvoiceDelivery {
  invoiceId     Int      @id
  receiverName  String
  receiverPhone String
  address       String
  ward          String   @default("")
  province      String   @default("")
  partnerId     Int?
  fee           Int      @default(0)
  cod           Int      @default(0)
  weight        Int      @default(0)
  note          String   @default("")
  status        String   @default("pending")
  trackingCode  String   @default("")
  updatedAt     DateTime @default(now())
}

model SaleReturn {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  invoiceId         Int?
  branchId          Int
  customerId        Int?
  createdById       Int
  status            String   @default("completed")
  subtotal          Int      @default(0)
  returnFee         Int      @default(0)
  total             Int      @default(0)
  refunded          Int      @default(0)
  toDebt            Int      @default(0)
  pointsReversed    Int      @default(0)
  pointsRefunded    Int      @default(0)
  costTotal         Int      @default(0)
  refundMethod      String   @default("cash")
  fundId            Int?
  exchangeInvoiceId Int?
  note              String   @default("")
  createdAt         DateTime @default(now())
  lines             SaleReturnLine[]

  @@index([invoiceId])
  @@index([branchId, createdAt])
}

model SaleReturnLine {
  id            Int        @id @default(autoincrement())
  returnId      Int
  ret           SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceLineId Int?
  productId     Int
  unitId        Int?
  conversion    Int        @default(1)
  qty           Int
  price         Int
  amount        Int
  cost          Int        @default(0)

  @@index([returnId])
}

model CustomerOrder {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  branchId      Int
  customerId    Int?
  createdById   Int
  sellerId      Int?
  status        String    @default("draft")
  channel       String    @default("store")
  subtotal      Int       @default(0)
  discount      Int       @default(0)
  total         Int       @default(0)
  deposit       Int       @default(0)
  depositUsed   Int       @default(0)
  depositFundId Int?
  expectedAt    DateTime?
  note          String    @default("")
  isDelivery    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lines         CustomerOrderLine[]

  @@index([branchId, createdAt])
}

model CustomerOrderLine {
  id           Int           @id @default(autoincrement())
  orderId      Int
  order        CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int
  unitId       Int?
  conversion   Int           @default(1)
  qty          Int
  price        Int
  discount     Int           @default(0)
  deliveredQty Int           @default(0)

  @@index([orderId])
}

model Shift {
  id           Int       @id @default(autoincrement())
  branchId     Int
  userId       Int
  openedAt     DateTime  @default(now())
  openingCash  Int       @default(0)
  closedAt     DateTime?
  countedCash  Int?
  expectedCash Int?
  note         String    @default("")

  @@index([userId, closedAt])
}

model SalesChannel {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String  @unique
  isActive Boolean @default(true)
}
